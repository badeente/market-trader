[Unit]
Description=Market Trader internal read-only report viewer
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/workspace/var/market-trader
ExecStart=%h/workspace/.venvs/market-trader-web/bin/market-trader serve-reports --directory %h/workspace/var/market-trader/reports --bind 10.10.1.136 --port 8086 --allow-network 10.10.1.0/24
Restart=on-failure
RestartSec=5
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=256M
TasksMax=32
LimitNOFILE=128

[Install]
WantedBy=default.target
